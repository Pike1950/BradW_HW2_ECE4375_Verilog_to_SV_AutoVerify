{
  "name": "Verilator + GTKWave",
  "build": {
    "dockerfile": "../Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "mshr-h.veriloghdl",
        "eirikpre.systemverilog",
        "wavetrace.wavetrace"
      ],
      "settings": {
